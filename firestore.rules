rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 力士の成績（ランキング用）。誰でも読めて、自分の分だけ書ける
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 8
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 10000;
    }

    // オンライン対戦の待ち行列。自分の分だけ書けて、相手を見つけた人が消せる
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.peerId is string && request.resource.data.ts is number;
      allow delete: if request.auth != null;
    }
  }
}
